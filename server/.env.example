# Wolffie server settings.
# Copy this file to .env in the same folder and fill in your own values.
# Never commit .env.

# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3009
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Database (SQLite) ────────────────────────────────────────────────────
# Absolute path. Created on first start if it doesn't exist.
DB_PATH=/srv/data/wolffie/wolffie.db

# ── Data collection ──────────────────────────────────────────────────────
SNAPSHOT_INTERVAL=10000
CLEANUP_DAYS=7

# ── Logging ──────────────────────────────────────────────────────────────
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_RETENTION_DAYS=21

# ── Security ─────────────────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Encrypts stored credentials (e.g. cloud API keys). Exactly 32 characters.
# Don't change it once set: existing encrypted settings can't be read any more.
SETTINGS_ENCRYPTION_KEY=change-me-to-32-characters-long

# Optional. If empty, a random secret is made at every start,
# so tokens stop working after each restart.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=